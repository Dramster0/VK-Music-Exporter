{
  "manifest_version": 3,
  "name": "VK Music Exporter",
  "version": "0.5.4",
  "description": "Экспорт «Моей музыки» и плейлистов ВК в CSV. Бесплатно, без дополнительных входов и загрузки аудио.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Собрать список музыки",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
